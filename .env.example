# Copiá este archivo a ".env" (sin el ".example") y completá tus propios
# valores. El ".env" real NUNCA se sube al repo (está en .gitignore) —
# esta plantilla sí, para que cualquiera que clone el proyecto sepa qué
# variables necesita configurar.

# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-generada-de-verdad

# True en desarrollo local. SIEMPRE False en producción.
DJANGO_DEBUG=True

# Dominios/IPs permitidos, separados por coma. Vacío está bien mientras
# DEBUG=True; obligatorio completar cuando DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Broker de Celery. Por defecto "filesystem://" — usa carpetas del disco
# como cola, sin instalar nada más (ideal si no tenés Docker/Redis). Si
# más adelante instalás Redis (nativo, WSL, o Memurai), cambiá esto a:
#   redis://localhost:6379/0
CELERY_BROKER_URL=filesystem://
