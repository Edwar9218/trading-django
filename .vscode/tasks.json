{
  // ============================================================
  //  Tablero de Canales — arranque dentro de VS Code
  //  Levanta servidor Django, worker y beat de Celery, cada uno en
  //  su propia terminal integrada. Se dispara solo al abrir la
  //  carpeta (arrancar_vscode.bat) y también a mano desde
  //  Terminal > Ejecutar tarea > "Tablero: arrancar todo".
  //
  //  Usa los ejecutables del venv directamente ("type": "process"),
  //  sin pasar por activate.bat: así funciona igual si la terminal
  //  por defecto de VS Code es PowerShell o CMD.
  //
  //  La primera vez VS Code pregunta "Permitir tareas automáticas":
  //  hay que aceptar, si no solo se arrancan a mano.
  // ============================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django - servidor web",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["manage.py", "runserver"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "tablero", "reveal": "always" }
    },
    {
      "label": "Celery - worker",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\celery.exe",
      // --pool=solo es obligatorio en Windows (ver AGENTS.md, decisiones técnicas)
      "args": ["-A", "config", "worker", "-l", "info", "--pool=solo"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "tablero", "reveal": "always" }
    },
    {
      "label": "Celery - beat",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\celery.exe",
      "args": ["-A", "config", "beat", "-l", "info"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "tablero", "reveal": "always" }
    },
    {
      "label": "Tablero: arrancar todo",
      "dependsOn": ["Django - servidor web", "Celery - worker", "Celery - beat"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
